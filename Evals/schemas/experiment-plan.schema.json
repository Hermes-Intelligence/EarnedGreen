{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["experiment_id", "status", "provider", "model_profile", "controls", "budget", "runs"],
  "properties": {
    "experiment_id": { "type": "string" },
    "status": { "enum": ["awaiting-budget-approval", "approved", "running", "complete", "invalid"] },
    "provider": { "type": "string" },
    "model_profile": { "type": "string" },
    "controls": { "type": "object" },
    "budget": { "type": "object", "required": ["max_total_cost", "max_wall_hours", "approved"] },
    "runs": { "type": "array", "minItems": 1 }
  }
}
