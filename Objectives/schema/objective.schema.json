{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-work.local/schemas/objective.schema.json",
  "title": "Agentic Work Objective",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "source", "status", "pillars"],
  "properties": {
    "id": { "type": "string", "pattern": "^OBJ-[0-9]{8}-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 5 },
    "source": {
      "type": "object",
      "required": ["artifact", "captured_at"],
      "properties": {
        "artifact": { "type": "string" },
        "captured_at": { "type": "string", "format": "date-time" }
      }
    },
    "status": { "enum": ["draft", "active", "blocked", "verified", "archived"] },
    "pillars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "requirements"],
        "properties": {
          "id": { "type": "string", "pattern": "^P[0-9]{2}$" },
          "title": { "type": "string" },
          "requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "statement", "status", "acceptance", "evidence"],
              "properties": {
                "id": { "type": "string", "pattern": "^REQ-[A-Z]+-[0-9]{3}$" },
                "statement": { "type": "string", "minLength": 10 },
                "status": { "enum": ["pending", "in_progress", "partial", "verified", "blocked", "rejected", "not_applicable"] },
                "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
                "evidence": { "type": "array", "items": { "type": "string" } },
                "notes": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
