{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "candidate_id", "release", "status", "stable_manifest_before_sha256", "required_evals", "files"],
  "properties": {
    "schema_version": { "const": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "release": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[a-z0-9.-]+)?$" },
    "status": { "enum": ["awaiting-eval", "awaiting-approval"] },
    "stable_manifest_before_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "required_evals": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "required": ["report", "minimum_passed", "maximum_failed"], "properties": { "report": { "type": "string" }, "minimum_passed": { "type": "integer", "minimum": 1 }, "maximum_failed": { "type": "integer", "minimum": 0 } } }
    },
    "release_gate_report": { "type": "string", "description": "Path (candidate-relative) to a release-gate.ps1 -Mode full report with passed=true, produced against the current repo." },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "target", "before_sha256", "after_sha256"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "before_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
          "after_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" }
        }
      }
    }
  }
}
